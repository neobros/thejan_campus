# Used by `npm run build:demo` — a labelled preview build for staging and client review.
# It never contacts a backend.
VITE_API_MODE=mock
VITE_MOCK_LATENCY=200

# Public origin of the live site — used for canonical URLs, sitemap and social-share (Open Graph) tags.
VITE_SITE_URL=https://aitcampus.com
