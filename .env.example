# Copy to .env (development) or .env.production (live build) and fill in.

# Where content comes from:
#   mock = the labelled demo dataset in src/api/mock (development and client previews only)
#   http = the real backend API (required for `npm run build`)
VITE_API_MODE=mock

# Base URL of the backend API, without a trailing slash. Required when VITE_API_MODE=http.
# The frontend calls the endpoints described in docs/specification.md §10, e.g. ${VITE_API_BASE_URL}/api/courses
VITE_API_BASE_URL=

# Public origin of the website, used for canonical URLs, e.g. https://www.example.edu
VITE_SITE_URL=

# Mock mode only: simulated network latency in milliseconds (default 250).
VITE_MOCK_LATENCY=250
